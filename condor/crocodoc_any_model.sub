universe = docker
docker_image = gjoschka/kinodata3d-pt2.5.1-cu121-cudnn9
executable = run_python_script_with_setup.sh
arguments = crocodoc_any_model --wandb-run-id $(wandb_run_id) --model-checkpoint-path $(checkpoint_path) --model-type $(model_type) --batch-size $(batch_size) --device cuda:0 --outfile crocodoc_results_$(wandb_run_id).csv --predict-outfile predictions/predictions_$(wandb_run_id).csv $(extra_arg)
error = crocodoc_any_model.$(ClusterId).$(ProcId).err
log = crocodoc_any_model.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 16
request_memory = 64G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true

queue wandb_run_id, checkpoint_path, model_type, batch_size, extra_arg from (
   r78ndufb, lightning_logs/r78ndufb/checkpoints/best.ckpt, cgnn3d, 64, --on-test
   e5qrnuwy, lightning_logs/e5qrnuwy/checkpoints/best.ckpt, cgnn3d, 64, --on-test
   9u4zikfi, lightning_logs/9u4zikfi/checkpoints/best.ckpt, cgnn3d, 64, --on-test
   tjlpnozx, lightning_logs/tjlpnozx/checkpoints/best.ckpt, cgnn3d, 64, --on-test
   6aljx035, lightning_logs/6aljx035/checkpoints/best.ckpt, cgnn3d, 64, --on-test
   5la80mcx, lightning_logs/5la80mcx/checkpoints/best.ckpt, cgnn3d, 64, --on-test
   lekb3zkf, lightning_logs/lekb3zkf/checkpoints/best.ckpt, cgnn3d, 64, --on-test
   g22attkk, lightning_logs/g22attkk/checkpoints/best.ckpt, cgnn3d, 64, --on-test
   rxj399da, lightning_logs/rxj399da/checkpoints/best.ckpt, cgnn3d, 64, --on-test
)
