universe = docker
docker_image = gjoschka/kinodata3d-pt2.5.1-cu121-cudnn9
executable = train_dimenet.sh
arguments =  $(split) $(rmsd) $(index) 
error = train_dimenet.$(ClusterId).$(ProcId).err
log = train_dimenet.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 32
request_memory = 128G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue index, rmsd, split from (
   0, 2, scaffold-k-fold
)
