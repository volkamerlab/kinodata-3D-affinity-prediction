universe = docker
docker_image = gjoschka/kinodata3d-b0:2.3.0-cuda12.1
executable = crocodoc_resid_frompath.sh
arguments = $(modelpath) $(outfile)
output = crocdoc_resid_frompath.$(ClusterId).$(ProcId).out
error = crocdoc_resid_frompath.$(ClusterId).$(ProcId).err
log = crocdoc_resid_frompath.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 32
request_memory = 64G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue modelpath, outfile from (
	az95x9z0,az95x9z0
	g3zw13yd,g3zw13yd
	wca70ojg,wca70ojg
	7a9bmcak,7a9bmcak
	yv5jjwrx,yv5jjwrx
)
