universe = docker
docker_image = gjoschka/kinodata3d-pt2.5.1-cu121-cudnn9
executable = compute_representations.sh
arguments = $(run_id) model_representations
output = compute_representations.$(ClusterId).$(ProcId).out
error = compute_representations.$(ClusterId).$(ProcId).err
log = compute_representations.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 32
request_memory = 128G
requirements = (UidDomain == "cs.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 32000)
+WantGPUHomeMounted = true
queue run_id from (
   rxj399da 
)
