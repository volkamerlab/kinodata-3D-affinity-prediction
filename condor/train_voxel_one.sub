universe = docker
docker_image = gjoschka/kinodata3d-b0:2.3.0-cuda12.1
executable = train_voxel.sh
arguments = $(split_type) $(fold) $(hidden_channels) $(batch_size) $(acc_grad_batches) $(kernel_sizes) $(lr) $(lr_decay) $(random_rotation_augmentations)
output = train_kinodata_voxel.$(ClusterId).$(ProcId).out
error = train_kinodata_voxel.$(ClusterId).$(ProcId).err
log = train_kinodata_voxel.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 32
request_memory = 128G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue split_type, fold, hidden_channels, batch_size, acc_grad_batches, kernel_sizes, lr, lr_decay, random_rotation_augmentations from (
   scaffold-k-fold, 0, 32, 32, 1, 433, 0.001, 0.01, True
)