universe = docker
docker_image = gjoschka/kinodata3d-b0:2.3.0-cuda12.1
executable = train_generic.sh
arguments = $(script) $(split) $(rmsd) $(index) $(model) $(ablate)
output = train_kinodata.$(ClusterId).$(ProcId).out
error = train_kinodata.$(ClusterId).$(ProcId).err
log = train_kinodata.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 32
request_memory = 64G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue index, model, rmsd, script, split, ablate from (
   0, cgnn.yaml, 2, train_sparse_transformer, scaffold-k-fold, 1
   1, cgnn.yaml, 2, train_sparse_transformer, scaffold-k-fold, 1
   2, cgnn.yaml, 2, train_sparse_transformer, scaffold-k-fold, 1
   3, cgnn.yaml, 2, train_sparse_transformer, scaffold-k-fold, 1
   4, cgnn.yaml, 2, train_sparse_transformer, scaffold-k-fold, 1
)
